# llm-wiki env overrides — copy to .env and edit as needed.
# Uncomment any line to override the default.

# Repo root (default: parent of tools/ — derived from paths.py location)
# WIKI_ROOT=/abs/path/to/your-wiki-repo

# Wiki data folder layout (default: <WIKI_ROOT>/wiki, <WIKI_ROOT>/raw, etc.)
# WIKI_DIR=wiki
# RAW_DIR=raw
# RAW_INBOX=raw/inbox
# ARCHIVED_DIR=archived
# WIKI_PROPOSALS=wiki/.proposals
# WIKI_LOG_FILE=wiki/log.md
# WIKI_INDEX_FILE=wiki/index.md

# RAG chunk index (default: <WIKI_ROOT>/rag/.rag_index)
# RAG_INDEX_DIR=rag/.rag_index

# SQLite + FTS5 search DB (default: <WIKI_DIR>/.wiki.db)
# WIKI_DB=wiki/.wiki.db

# Embedding model (default: multilingual MiniLM, 384-dim, on-device, no API)
# WIKI_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# WIKI_EMBED_DIM=384

# Hybrid search weights (BM25 + vector). Sum không cần = 1, normalized internally.
# WIKI_BM25_WEIGHT=0.5
# WIKI_VEC_WEIGHT=0.5

# MCP server (default: INFO, name "llm-wiki-mcp")
# WIKI_MCP_LOG=INFO
# WIKI_MCP_NAME=llm-wiki-mcp

# tools/watch.py intervals (seconds)
# WATCH_INGEST_SEC=15
# WATCH_REINDEX_SEC=300
# WATCH_RAG_SEC=1800
# WATCH_LINT_SEC=3600
